# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be an email on a domain you've verified in Resend (Domains tab)
RESEND_FROM_EMAIL="Gurur Consultancy <no-reply@gurur.in>"

# Where the internal notification email goes
CONTACT_NOTIFY_EMAIL=info@gurur.in

# Used to build the absolute logo URL inside emails (public/logo.png)
NEXT_PUBLIC_SITE_URL=https://www.gurur.in
